<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.zfs-shutdown-hook</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>{{SCRIPT_DIR}}/lib/shutdown-hook.sh</string>
    </array>
    
    <key>RunAtLoad</key>
    <false/>
    
    <key>KeepAlive</key>
    <false/>
    
    <!-- Run before logout/shutdown -->
    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
    </array>
    
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/zfs-shutdown-hook.log</string>
    
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/zfs-shutdown-hook-error.log</string>
</dict>
</plist>
