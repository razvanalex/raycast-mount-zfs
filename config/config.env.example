#!/bin/bash
# ZFS Mount Configuration
# This file configures the automated ZFS mount/unmount scripts for UTM VM

###################
# VM Settings
###################
VM_NAME="ZFS-Linux"
VM_IP="192.168.64.2"
VM_USER="root"
VM_STARTUP_TIMEOUT=60        # seconds to wait for VM boot
VM_SSH_TIMEOUT=5             # seconds per SSH connection attempt

###################
# Mount Settings
###################
MOUNT_BASE="/Volumes"        # Base directory for macOS mounts
SAMBA_USER="guest"           # Samba username (use "guest" for no password)
SAMBA_PASSWORD=""            # Samba password (leave empty for guest)

###################
# Pool Configuration
###################
# Format: POOL_NAME:USB_VENDOR_ID:USB_PRODUCT_ID:SAMBA_SHARE:DESCRIPTION
# 
# To find USB IDs for your drives, run:
# osascript -e 'tell application "UTM" to get properties of every usb device'

# Pool: tank (Western Digital My Passport 2TB)
POOL_tank_NAME="tank"
POOL_tank_USB_VENDOR=4184
POOL_tank_USB_PRODUCT=9766
POOL_tank_SAMBA_SHARE="ZFS_Shared"
POOL_tank_VM_MOUNT_PATH="/tank"
POOL_tank_DESCRIPTION="Main ZFS Storage"

# Add more pools here following the same pattern:
# POOL_backup_NAME="backup"
# POOL_backup_USB_VENDOR=1234
# POOL_backup_USB_PRODUCT=5678
# POOL_backup_SAMBA_SHARE="ZFS_Backup"
# POOL_backup_VM_MOUNT_PATH="/backup"
# POOL_backup_DESCRIPTION="Backup Drive"

# List of all configured pool names (space-separated)
POOL_NAMES="tank"

###################
# Behavior Settings
###################
# Unmount strategy: "conservative" | "hybrid" | "aggressive"
# - conservative: Wait and retry, never force
# - hybrid: Ask user, offer force option on repeated failures
# - aggressive: Auto force-unmount after retries fail
UNMOUNT_STRATEGY="hybrid"

# VM shutdown mode: "smart" | "always" | "ask"
# - smart: Only stop VM if all pools are unmounted
# - always: Always stop VM after unmount
# - ask: Prompt user each time
VM_SHUTDOWN_MODE="smart"

# Retry settings
RETRY_ATTEMPTS=3             # Number of retries for busy operations
RETRY_DELAY=5                # Seconds between retry attempts
SAMBA_STARTUP_DELAY=3        # Seconds to wait for Samba after start/restart

###################
# Health Check
###################
CHECK_POOL_HEALTH=true       # Check pool health after import?
WARN_ON_DEGRADED=true        # Show warning if pool is degraded?
WARN_ON_ERRORS=true          # Show warning if pool has errors?

###################
# Logging
###################
ENABLE_LOGGING=true
LOG_FILE="$HOME/Library/Logs/zfs-mount.log"
LOG_LEVEL="INFO"             # DEBUG | INFO | WARN | ERROR

###################
# Advanced Options
###################
# Show detailed errors in notifications?
VERBOSE_NOTIFICATIONS=true

# Enable graceful shutdown on macOS logout/shutdown?
ENABLE_SHUTDOWN_HOOK=true
